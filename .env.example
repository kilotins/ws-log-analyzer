# LogPilot — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# --- AI Providers (all optional) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Local AI (optional) ---
LOGPILOT_AI_ENDPOINT=http://localhost:1234/v1
LOGPILOT_AI_MODEL=

# --- PII Redaction ---
# Options: none, secrets (default), standard, strict
LOGPILOT_REDACTION_LEVEL=secrets
